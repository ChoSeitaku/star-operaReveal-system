# 经营归因分析系统 — 环境变量样例
# 复制为 .env 后按需修改。所有键均可用系统环境变量覆盖（系统环境变量优先级最高）。

# ---------- 服务端口 ----------
BACKEND_PORT=8000
AUTH_PORT=8001
# 浏览器访问后端的基地址，必须与认证中心回调白名单一致（localhost 与 127.0.0.1 不可混用）
PUBLIC_BASE_URL=http://localhost:8000
AUTH_CENTER_URL=http://localhost:8001

# ---------- 数据目录 ----------
DATA_DIR=data

# ---------- 会话密钥 ----------
# 留空则自动生成并持久化到 data/secret.key（保证重启后登录态不失效）
STAR_SESSION_SECRET=

# ---------- 认证中心客户端凭据 ----------
OAUTH_CLIENT_ID=star-demo
OAUTH_CLIENT_SECRET=star-demo-secret
SESSION_TTL_SECONDS=86400
WS_TOKEN_TTL_SECONDS=60

# ---------- LLM（Anthropic Messages 协议） ----------
# 不配置也可运行：默认分析引擎为 demo（规则化演示引擎，零 API Key）
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-v4-pro

# ---------- 分析引擎 ----------
# demo = 规则化演示引擎（默认，无需 API Key）；llm = 大模型 Agent 引擎
ANALYSIS_ENGINE_MODE=demo
ANALYSIS_MAX_CONCURRENT_TASKS=2
